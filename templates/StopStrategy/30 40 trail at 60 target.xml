<?xml version="1.0" encoding="utf-8"?>
<NinjaTrader>
  <StopStrategy xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <AutoBreakEvenPlus>0</AutoBreakEvenPlus>
    <AutoBreakEvenProfitTrigger>60</AutoBreakEvenProfitTrigger>
    <AutoTrailSteps>
      <AutoTrailStep>
        <Frequency>3</Frequency>
        <ProfitTrigger>40</ProfitTrigger>
        <StopLoss>30</StopLoss>
      </AutoTrailStep>
    </AutoTrailSteps>
    <IsSimStopEnabled>false</IsSimStopEnabled>
    <VolumeTrigger>1</VolumeTrigger>
    <Template>30 40 trail at 60 target</Template>
  </StopStrategy>
</NinjaTrader>